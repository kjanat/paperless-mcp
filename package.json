{
	"name": "@kjanat/paperless-mcp",
	"version": "3.0.0",
	"description": "MCP server for interacting with Paperless-ngx document management system.",
	"keywords": [
		"paperless-ngx",
		"paperless",
		"ai",
		"mcp",
		"model-context-protocol",
		"document-management",
		"dreamcli",
		"ansispeck"
	],
	"repository": "kjanat/paperless-mcp",
	"license": "MIT",
	"author": "Kaj Kowalski",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#pkg": "./package.json"
	},
	"bin": {
		"paperless-mcp": "dist/index.js"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"dist",
		"skills"
	],
	"scripts": {
		"bd": "bun build src/index.ts --minify --outdir=dist --target=node --banner='#!/usr/bin/env node'",
		"fmt": "dprint fmt -c=\"${PWD}/.dprint.jsonc\"",
		"fmt:check": "dprint check -c=\"${PWD}/.dprint.jsonc\"",
		"gen": "run -s gen:subset gen:zod",
		"gen:full": "run -s gen:schema gen",
		"gen:schema": "export OUT=\"${PWD}/schemas/openapi.json\"; run openapi generate -o \"${OUT}\" && run fmt \"${OUT}\"",
		"gen:subset": "export OUT=\"${PWD}/schemas/subset.json\"; run openapi extract \"${PWD}/schemas/openapi.json\" -o \"${OUT}\" && run fmt \"${OUT}\"",
		"gen:zod": "openapi-ts && run fmt src/api/generated/** --allow-no-files",
		"inspect": "bunx @modelcontextprotocol/inspector run mcp",
		"lint": "biome lint",
		"mcp": "bun src/index.ts",
		"meta": "bash scripts/meta.sh",
		"prepack": "bun bd",
		"start": "run mcp",
		"typecheck": "bunx @typescript/native --noEmit",
		"uv:sync:frozen": "uv sync --frozen",
		"uv:sync:upgrade:paperless": "uv sync --upgrade-package paperless-ngx"
	},
	"devDependencies": {
		"@actions/github-script": "github:actions/github-script",
		"@hey-api/openapi-ts": "^0.99.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/bun": "^1.3.14",
		"@types/express": "^5.0.6",
		"@typescript/native": "npm:typescript@^7",
		"biome": "npm:@biomejs/biome@^2.5.5",
		"dprint": "0.55.2",
		"dreamcli": "npm:@kjanat/dreamcli@^3.0.1",
		"express": "^5.2.1",
		"pkg-pr-new": "^0.0.79",
		"runner-run": "^0.21.0",
		"tombi": "^1.2.4",
		"typescript": "<7",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=22"
	},
	"volta": {
		"node": "26.3.0",
		"npm": "11.16.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "dev"
	}
}
